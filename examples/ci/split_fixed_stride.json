{
    "pipeline": "split",
    "expected_output": {
        "min_processed_videos": 1,
        "min_passed_clips": 1
    },
    "args": {
        "input_video_path": "FILL_IN",
        "input_video_list_json_path": null,
        "output_clip_path": "FILL_IN",
        "input_s3_profile_name": "default",
        "input_video_list_s3_profile_name": "default",
        "output_s3_profile_name": "default",
        "limit": 1,
        "limit_clips": 0,
        "generate_embeddings": true,
        "embedding_algorithm": "cosmos-embed1-224p",
        "generate_previews": false,
        "generate_captions": true,
        "caption_quality_stats_enabled": true,
        "upload_clips": true,
        "upload_cds_parquet": false,
        "generate_cosmos_predict_dataset": false,
        "splitting_algorithm": "fixed-stride",
        "fixed_stride_split_duration": 10,
        "fixed_stride_min_clip_length_s": 2,
        "transcode_encoder": "libopenh264",
        "clip_re_chunk_size": 32,
        "clip_extraction_target_res": 224,
        "motion_filter": "disable",
        "aesthetic_threshold": null,
        "vlm_filter": "disable",
        "embedding_gpus_per_worker": 0.25,
        "embedding_batch_size": 8,
        "captioning_algorithm": "qwen",
        "captioning_window_size": 256,
        "captioning_remainder_threshold": 128,
        "captioning_prompt_variant": "default",
        "captioning_prompt_text": null,
        "captioning_sampling_fps": 2.0,
        "captioning_max_output_tokens": 8192,
        "qwen_batch_size": 16,
        "qwen_num_gpus_per_worker": 1,
        "num_download_workers_per_node": 4,
        "num_clip_writer_workers_per_node": 8,
        "verbose": false,
        "perf_profile": true
    }
}
