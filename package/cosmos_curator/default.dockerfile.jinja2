# syntax=docker/dockerfile:1
# Dockerfile template for cosmos-curator images.
#
# Normal full and slim images use the root Pixi lock and conda-forge LGPL media
# stack. Redistributable builds use distributable/pixi.toml plus a custom
# FFmpeg/PyAV/OpenCV wheelhouse built in this template.

ARG DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# Tools/artifacts stage
# ---------------------------------------------------------------------------
FROM nvcr.io/nvidia/cuda:13.0.3-devel-ubuntu24.04 AS wheels-builder

ARG PIXI_VERSION=v0.82.0

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*

# Install pixi with curl into /opt/pixi without modifying PATH.
RUN curl -fsSL https://pixi.sh/install.sh | \
    PIXI_VERSION="${PIXI_VERSION}" PIXI_HOME=/opt/pixi PIXI_NO_PATH_UPDATE=1 PIXI_NO_TELEMETRY=1 sh

{% if not slim and 'seedvr' in envs %}
# SeedVR tarball: fetch here so the main image does not need curl (libcurl pulls krb5).
ARG SEEDVR_COMMIT=e4de8c2
RUN mkdir -p /opt/seedvr-artifacts \
    && curl -fsSL --retry 5 --retry-delay 3 --max-time 300 "https://github.com/ByteDance-Seed/SeedVR/archive/${SEEDVR_COMMIT}.tar.gz" \
        | tar xz -C /tmp \
    && mv /tmp/SeedVR-${SEEDVR_COMMIT}* /opt/seedvr-artifacts/SeedVR
{% endif %}

{% if redistributable %}
# ---------------------------------------------------------------------------
# FFmpeg builder stage
# ---------------------------------------------------------------------------
FROM nvcr.io/nvidia/cuda:13.0.3-devel-ubuntu24.04 AS ffmpeg-builder

SHELL ["/bin/bash", "-c"]

{% set ffmpeg_protocols = [
    "file",
    "pipe",
] %}
{% set ffmpeg_demuxers = [
    "image2",
    "ivf",
    "matroska",
    "mov",
    "rawvideo",
    "webp",
] %}
{% set ffmpeg_muxers = [
    "image2",
    "ivf",
    "matroska",
    "mp4",
    "null",
    "rawvideo",
    "webm",
    "webp",
] %}
{% set ffmpeg_decoders = [
    "av1",
    "libdav1d",
    "libvpx_vp8",
    "libvpx_vp9",
    "png",
    "rawvideo",
    "vp8",
    "vp9",
    "webp",
] %}
{% set ffmpeg_encoders = [
    "libaom_av1",
    "libvpx_vp8",
    "libvpx_vp9",
    "libwebp",
    "png",
    "rawvideo",
] %}
{% set ffmpeg_parsers = [
    "av1",
    "png",
    "vp8",
    "vp9",
    "webp",
] %}
{% set ffmpeg_bsfs = [
    "av1_frame_merge",
    "av1_frame_split",
    "vp9_superframe",
    "vp9_superframe_split",
] %}
{% set ffmpeg_filters = [
    "anull",
    "aresample",
    "format",
    "fps",
    "null",
    "scale",
    "select",
    "setpts",
    "trim",
] %}

ENV FFMPEG_VERSION=8.1.2

RUN mkdir -p /tmp && chmod 1777 /tmp && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libcrypt-dev \
    autoconf \
    automake \
    build-essential \
    cmake \
    libaom-dev \
    libdav1d-dev \
    libtool \
    libvpx-dev \
    libwebp-dev \
    nasm \
    pkg-config \
    texinfo \
    xz-utils \
    yasm \
    zlib1g-dev && \
    curl -fsSL -o /tmp/ffmpeg.tar.xz https://www.ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz && \
    tar xJf /tmp/ffmpeg.tar.xz -C /tmp/ && \
    cd /tmp/ffmpeg-${FFMPEG_VERSION} && \
    ./configure \
    --prefix=/opt/ffmpeg \
    --disable-everything \
    --disable-autodetect \
    --disable-gpl \
    --disable-programs \
    --enable-ffmpeg \
    --enable-ffprobe \
    --enable-avcodec \
    --enable-avformat \
    --enable-avfilter \
    --enable-swresample \
    --enable-swscale \
    --enable-zlib \
    --enable-libaom \
    --enable-libdav1d \
    --enable-libvpx \
    --enable-libwebp \
    --enable-protocol={{ ffmpeg_protocols | join(',') }} \
    --enable-demuxer={{ ffmpeg_demuxers | join(',') }} \
    --enable-muxer={{ ffmpeg_muxers | join(',') }} \
    --enable-decoder={{ ffmpeg_decoders | join(',') }} \
    --enable-encoder={{ ffmpeg_encoders | join(',') }} \
    --enable-parser={{ ffmpeg_parsers | join(',') }} \
    --enable-bsf={{ ffmpeg_bsfs | join(',') }} \
    --enable-filter={{ ffmpeg_filters | join(',') }} \
    --extra-libs=-lpthread \
    --extra-libs=-lm \
    --disable-static \
    --enable-shared \
    --disable-doc \
    --disable-debug && \
    make -j$(nproc) && \
    make install && \
    echo "/opt/ffmpeg/lib" > /etc/ld.so.conf.d/ffmpeg.conf && \
    ldconfig && \
    /opt/ffmpeg/bin/ffmpeg -version && \
    /opt/ffmpeg/bin/ffprobe -version && \
    found=$(find /opt/ffmpeg /usr/lib /usr/local/lib -name 'libopenh264*' 2>/dev/null) && \
    if [ -n "$found" ]; then \
        echo "ERROR: redistributable build contains libopenh264:"; \
        echo "$found"; \
        exit 1; \
    fi

# ---------------------------------------------------------------------------
# PyAV builder stage
# ---------------------------------------------------------------------------
# PyPI's PyAV wheels bundle their own FFmpeg shared libs. Build from source
# against /opt/ffmpeg so Python and the ffmpeg CLI share one codec policy.
FROM nvcr.io/nvidia/cuda:13.0.3-devel-ubuntu24.04 AS pyav-builder

SHELL ["/bin/bash", "-c"]

COPY --from=wheels-builder /opt/pixi/bin/pixi /usr/local/bin/pixi
COPY --from=ffmpeg-builder /opt/ffmpeg /opt/ffmpeg

RUN echo "/opt/ffmpeg/lib" > /etc/ld.so.conf.d/ffmpeg.conf && \
    ldconfig && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

COPY distributable/pixi.toml distributable/pixi.lock /pyav-build/

RUN cd /pyav-build && \
    export CONDA_OVERRIDE_CUDA=13.0.3 && \
    export CUDA_PATH="/usr/local/cuda" && \
    success=false && \
    for attempt in {1..10}; do \
        if pixi install -e default --frozen 2>&1; then \
            success=true && break; \
        fi; \
        echo "pixi install attempt $attempt/10 failed, retrying in 3s..." && sleep 3; \
    done && \
    pixi clean cache -y && \
    $success && \
    export PKG_CONFIG_PATH="/opt/ffmpeg/lib/pkgconfig" && \
    export LD_LIBRARY_PATH="/opt/ffmpeg/lib:${LD_LIBRARY_PATH:-}" && \
    mkdir -p /pyav-wheelhouse && \
    pixi run --as-is -e default pip wheel --no-binary av --no-cache-dir --no-build-isolation \
        --wheel-dir /pyav-wheelhouse av==17.0.0 && \
    rm -rf /pyav-build/.pixi /root/.cache/pip /tmp/pip-*

# ---------------------------------------------------------------------------
# OpenCV builder stage
# ---------------------------------------------------------------------------
# PyPI's opencv-python-headless wheels bundle their own FFmpeg shared libs.
# Build from source against /opt/ffmpeg so cv2 uses the redistributable policy.
# TIFF support is disabled because libtiff6 pulls libjbig0, which is
# GPL-family and cannot ship without legal review.
FROM nvcr.io/nvidia/cuda:13.0.3-devel-ubuntu24.04 AS opencv-builder

SHELL ["/bin/bash", "-c"]

ARG OPENCV_PYTHON_REPO=https://github.com/opencv/opencv-python.git

COPY --from=wheels-builder /opt/pixi/bin/pixi /usr/local/bin/pixi
COPY --from=ffmpeg-builder /opt/ffmpeg /opt/ffmpeg
COPY --from=pyav-builder /pyav-wheelhouse /pyav-wheelhouse

RUN echo "/opt/ffmpeg/lib" > /etc/ld.so.conf.d/ffmpeg.conf && \
    ldconfig && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        libaom3 \
        libdav1d7 \
        libavif16 \
        libdrm2 \
        libgfortran5 \
        libjpeg-turbo8 \
        libopenjp2-7 \
        libopenblas0-pthread \
        libpcre2-16-0 \
        libpng16-16t64 \
        $(if [ "$(dpkg --print-architecture)" = "amd64" ]; then echo libquadmath0; fi) \
        libvpx9 \
        libwebp7 \
        libwebpdemux2 \
        libwebpmux3 \
        ninja-build \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

COPY distributable/pixi.toml distributable/pixi.lock /opencv-build/

RUN cd /opencv-build && \
    export CONDA_OVERRIDE_CUDA=13.0.3 && \
    export CUDA_PATH="/usr/local/cuda" && \
    success=false && \
    for attempt in {1..10}; do \
        if pixi install -e default --frozen 2>&1; then \
            success=true && break; \
        fi; \
        echo "pixi install attempt $attempt/10 failed, retrying in 3s..." && sleep 3; \
    done && \
    pixi clean cache -y && \
    $success && \
    locked_pypi_version() { \
        pixi run --as-is -e default python -c 'import re, sys; from pathlib import Path; package = sys.argv[1]; contents = Path("pixi.lock").read_text(); match = re.search(r"- pypi: [^\n]+\n  name: " + re.escape(package) + r"\n  version: ([^\n]+)", contents); print(match.group(1)) if match else sys.exit(f"missing locked version for {package}")' "$1"; \
    } && \
    OPENCV_PYTHON_VERSION="$(locked_pypi_version opencv-python-headless)" && \
    OPENCV_PYTHON_TAG="${OPENCV_PYTHON_VERSION##*.}" && \
    git clone --recursive --depth 1 --branch "${OPENCV_PYTHON_TAG}" "${OPENCV_PYTHON_REPO}" /opencv-python-src && \
    pixi run --as-is -e default bash -c 'cd /opencv-python-src && python find_version.py False True False False' && \
    FOUND_OPENCV_PYTHON_VERSION=$(pixi run --as-is -e default bash -c 'cd /opencv-python-src && python -c '"'"'namespace = {}; exec(open("cv2/version.py", encoding="utf-8").read(), namespace); print(namespace["opencv_version"])'"'"'') && \
    if [ "$FOUND_OPENCV_PYTHON_VERSION" != "$OPENCV_PYTHON_VERSION" ]; then \
        echo "ERROR: opencv-python tag ${OPENCV_PYTHON_TAG} produced version ${FOUND_OPENCV_PYTHON_VERSION}, expected ${OPENCV_PYTHON_VERSION} from pixi.lock"; \
        exit 1; \
    fi && \
    export PKG_CONFIG_PATH="/opt/ffmpeg/lib/pkgconfig" && \
    export LD_LIBRARY_PATH="/opt/ffmpeg/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}" && \
    export LIBRARY_PATH="/opt/ffmpeg/lib:/usr/local/cuda/lib64:${LIBRARY_PATH:-}" && \
    pkg-config --modversion libavcodec libavformat libavutil libswscale && \
    pkg-config --cflags --libs libavcodec libavformat libavutil libswscale && \
    export ENABLE_HEADLESS=1 && \
    export CMAKE_ARGS="-DWITH_FFMPEG=ON -DWITH_GTK=OFF -DWITH_QT=OFF -DWITH_TIFF=OFF -DOPENCV_FFMPEG_SKIP_BUILD_CHECK=ON -DPKG_CONFIG_EXECUTABLE=/usr/bin/pkg-config -DCMAKE_PREFIX_PATH=/opt/ffmpeg -DCMAKE_LIBRARY_PATH=/opt/ffmpeg/lib -DCMAKE_INCLUDE_PATH=/opt/ffmpeg/include -DCMAKE_BUILD_RPATH=/opt/ffmpeg/lib -DCMAKE_INSTALL_RPATH=/opt/ffmpeg/lib" && \
    mkdir -p /opencv-wheelhouse && \
    pixi run --as-is -e default pip wheel --no-deps --no-cache-dir \
        --wheel-dir /opencv-wheelhouse /opencv-python-src{% if 'paddle-ocr' in envs or 'default' in envs %} && \
    rm -rf /opencv-python-src/_skbuild && \
    unset ENABLE_HEADLESS && \
    pixi run --as-is -e default pip wheel --no-deps --no-cache-dir \
        --wheel-dir /opencv-wheelhouse /opencv-python-src && \
    rm -rf /opencv-python-src/_skbuild && \
    export ENABLE_CONTRIB=1 && \
    pixi run --as-is -e default pip wheel --no-deps --no-cache-dir \
        --wheel-dir /opencv-wheelhouse /opencv-python-src{% endif %} && \
    pixi run --as-is -e default pip uninstall -y opencv-python-headless opencv-python opencv-contrib-python || true && \
    pixi run --as-is -e default pip install --no-cache-dir --no-deps /opencv-wheelhouse/opencv_python_headless-*.whl && \
    pixi run --as-is -e default python -c 'import cv2; info = cv2.getBuildInformation(); print(cv2.__version__); print(next((line for line in info.splitlines() if "FFMPEG:" in line), "FFMPEG: <missing>")); raise SystemExit(0 if "FFMPEG:                      YES" in info else 1)' && \
    patch_lock_wheel() { \
        package="$1"; \
        wheel_prefix="$2"; \
        wheel_path=$(find /pyav-wheelhouse /opencv-wheelhouse -maxdepth 1 -name "${wheel_prefix}*.whl" | sort | head -n 1); \
        if [ -z "$wheel_path" ]; then \
            echo "ERROR: missing local wheel for $package ($wheel_prefix)"; \
            exit 1; \
        fi; \
        export LOCK_PACKAGE="$package"; \
        export LOCK_WHEEL_NAME="$(basename "$wheel_path")"; \
        export LOCK_WHEEL_SHA="$(sha256sum "$wheel_path" | awk '{print $1}')"; \
        pixi run --as-is -e default python -c 'import os, re; from pathlib import Path; package = os.environ["LOCK_PACKAGE"]; wheel_name = os.environ["LOCK_WHEEL_NAME"]; wheel_sha = os.environ["LOCK_WHEEL_SHA"]; path = Path("pixi.lock"); contents = path.read_text(); wheel_regex = re.escape(wheel_name.split("-")[0]) + r"-[^\s\"'"'"']+\.whl"; contents = re.sub(r"https://files\.pythonhosted\.org/[^\s\"'"'"']+/" + wheel_regex, f"file:///opt/cosmos-curator-wheelhouse/{wheel_name}", contents); section_pattern = re.compile(r"(- pypi: file:///opt/cosmos-curator-wheelhouse/" + re.escape(wheel_name) + r"\n  name: " + re.escape(package) + r"\n  version: [^\n]+\n  sha256: )[^\n]+"); contents, count = section_pattern.subn(r"\g<1>" + wheel_sha, contents); path.write_text(contents); raise SystemExit(0 if count else f"did not patch sha256 for {package}")'; \
    } && \
    patch_lock_wheel av av-17.0.0 && \
    patch_lock_wheel opencv-python-headless "opencv_python_headless-${OPENCV_PYTHON_VERSION}"{% if 'paddle-ocr' in envs or 'default' in envs %} && \
    patch_lock_wheel opencv-python "opencv_python-${OPENCV_PYTHON_VERSION}" && \
    patch_lock_wheel opencv-contrib-python "opencv_contrib_python-${OPENCV_PYTHON_VERSION}"{% endif %} && \
    rm -rf /opencv-build/.pixi /opencv-python-src /root/.cache/pip /tmp/pip-*
{% endif %}{# redistributable #}

# ---------------------------------------------------------------------------
# Main stage
# ---------------------------------------------------------------------------
FROM nvcr.io/nvidia/cuda:13.0.3-devel-ubuntu24.04 AS main

SHELL ["/bin/bash", "-c"]
ENV NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
ENV TZ=America/Los_Angeles

RUN apt-get update \
    && apt-get install --no-install-recommends --option=Dpkg::Options::=--force-confdef -y \
    ca-certificates \
{%- if nsight %}
    nsight-systems-2025.3.2 \
{%- endif %}
    rclone \
{%- if redistributable %}
    libaom3 \
    libdav1d7 \
    libavif16 \
    libdrm2 \
    libgfortran5 \
    libjpeg-turbo8 \
    libopenjp2-7 \
    libopenblas0-pthread \
    libpcre2-16-0 \
    libpng16-16t64 \
    $(if [ "$(dpkg --print-architecture)" = "amd64" ]; then echo libquadmath0; fi) \
    libvpx9 \
    libwebp7 \
    libwebpdemux2 \
    libwebpmux3 \
{%- endif %}
    keyboxd gpgv gpgsm gpgconf gpg-agent \
    binutils openssl libsqlite3-0 \
    && update-ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

{% if redistributable %}
COPY --from=ffmpeg-builder /opt/ffmpeg /opt/ffmpeg
RUN echo "/opt/ffmpeg/lib" > /etc/ld.so.conf.d/ffmpeg.conf && \
    ldconfig && \
    /opt/ffmpeg/bin/ffmpeg -version > /dev/null && \
    /opt/ffmpeg/bin/ffprobe -version > /dev/null

RUN found=$(find /opt/ffmpeg /usr/lib /usr/local/lib -name 'libopenh264*' 2>/dev/null) && \
    if [ -n "$found" ]; then \
        echo "ERROR: redistributable runtime image contains libopenh264:"; \
        echo "$found"; \
        exit 1; \
    fi
{% endif %}

# Triton 3.6+ looks for a separate "ptxas-blackwell" binary on Blackwell GPUs
# (arch >= 100). The CUDA toolkit ships a single ptxas that already supports
# Blackwell, so a symlink is sufficient.
RUN ln -sf /usr/local/cuda/bin/ptxas /usr/local/cuda/bin/ptxas-blackwell

COPY --from=wheels-builder /opt/pixi/bin/pixi /usr/local/bin/pixi

{% if redistributable %}
ARG PKG_CONFIG_PATH
ENV AM_I_DOCKER=True \
    BUILD_WITH_CUDA=True \
    TORCH_CUDA_ARCH_LIST="8.0;8.6;9.0;10.0+PTX" \
    CUDA_HOME="/usr/local/cuda" \
    CUDA_PATH="/usr/local/cuda" \
    PATH="/opt/ffmpeg/bin:/usr/local/cuda/bin:${PATH}" \
    CPATH="/usr/local/cuda/include" \
    LIBRARY_PATH="/usr/local/cuda/lib64:${LIBRARY_PATH:-}" \
    PKG_CONFIG_PATH="/opt/ffmpeg/lib/pkgconfig:${PKG_CONFIG_PATH:-}" \
    LD_LIBRARY_PATH="/opt/ffmpeg/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}" \
    XFORMERS_IGNORE_FLASH_VERSION_CHECK="1" \
    VLLM_WORKER_MULTIPROC_METHOD="spawn"
{% else %}
ENV AM_I_DOCKER=True \
    BUILD_WITH_CUDA=True \
    TORCH_CUDA_ARCH_LIST="8.0;8.6;9.0;10.0+PTX" \
    CUDA_HOME="/usr/local/cuda" \
    CUDA_PATH="/usr/local/cuda" \
    PATH="/usr/local/cuda/bin:${PATH}" \
    CPATH="/usr/local/cuda/include" \
    LIBRARY_PATH="/usr/local/cuda/lib64:${LIBRARY_PATH:-}" \
    LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}" \
    XFORMERS_IGNORE_FLASH_VERSION_CHECK="1" \
    VLLM_WORKER_MULTIPROC_METHOD="spawn"
{% endif %}

ENV RAY_DEDUP_LOGS=0 \
    RAY_EXPERIMENTAL_NOSET_CUDA_VISIBLE_DEVICES=1 \
    RAY_MAX_LIMIT_FROM_API_SERVER=40000 \
    RAY_MAX_LIMIT_FROM_DATA_SOURCE=40000 \
    RAY_DEFAULT_OBJECT_STORE_MAX_MEMORY_BYTES=800000000000 \
    RAY_DEFAULT_OBJECT_STORE_MEMORY_PROPORTION=0.4 \
    RAY_gcs_rpc_server_connect_timeout_s=30 \
    RAY_gcs_rpc_server_reconnect_timeout_s=180 \
    RAY_WARN_BLOCKING_GET_INSIDE_ASYNC=0 \
    XENNA_RAY_METRICS_PORT=9002

ENV AWS_REQUEST_CHECKSUM_CALCULATION='when_required'

ENV DEFAULT_WORKSPACE_LOC="/config/default_workspace"
ENV HF_HOME="${DEFAULT_WORKSPACE_LOC}/weights/hf_home/" \
    LAION_CACHE_HOME="${DEFAULT_WORKSPACE_LOC}/weights/laion_cache/"

{% if redistributable %}
COPY --chown=1000:1000 distributable/pixi.toml {{code_dir_str}}/pixi.toml
{% else %}
COPY --chown=1000:1000 pixi.toml pixi.lock conda-pypi-map.json {{code_dir_str}}/
{% endif %}

{% if not slim %}
{% if redistributable %}
COPY --from=pyav-builder /pyav-wheelhouse /opt/cosmos-curator-wheelhouse
COPY --from=opencv-builder /opencv-wheelhouse /opt/cosmos-curator-wheelhouse
COPY --chown=1000:1000 --from=opencv-builder /opencv-build/pixi.lock {{code_dir_str}}/pixi.lock
{% endif %}

# If we install all the environments in a single layer, it's over 20GB and will cause slurm/NVCF to timeout pulling the
# layer. Since the cuml environment is large and needs non-overlapping RAPIDS packages, we install it separately.
#
# Retry logic: pixi install can fail due to transient network errors (connection resets, timeouts).
#
# IMPORTANT: Do NOT set RATTLER_CACHE_DIR or UV_CACHE_DIR to a BuildKit cache mount.
# Rattler uses hardlinks from its package cache into each environment directory. When
# multiple environments share packages (e.g. torch across default and seedvr),
# the hardlinked files share a single inode and Docker stores the data ONCE in the layer tar.
# Redirecting the cache to a mount (different filesystem) breaks hardlinks -- rattler falls
# back to full copies, duplicating multi-GB packages across every environment (~8GB -> ~21GB).
# Instead, let rattler use its default on-disk cache and clean it within the same RUN layer.
RUN cd {{code_dir_str}} && \
{%- if verbose %}
    echo "=== pixi version ===" && pixi --version && \
{%- endif %}
    export CONDA_OVERRIDE_CUDA=13.0.3 && \
{%- if verbose %}
    export RUST_LOG=uv=debug && \
    export UV_NO_PROGRESS=1 && \
    export NO_COLOR=1 && \
{%- endif %}
    export CUDA_PATH="/usr/local/cuda" && \
    success=false && \
    for attempt in {1..10}; do \
        echo "=== pixi install attempt $attempt/10 ===" && \
        if pixi install {{ '-v' if verbose else '' }} -e {{ envs | reject('equalto', 'cuml') | join(' -e ') }} --frozen 2>&1; then \
            success=true && break; \
        fi; \
        echo "pixi install attempt $attempt/10 failed, retrying in 3s..." && sleep 3; \
    done && \
    $success && \
    for env in {{ envs | reject('equalto', 'cuml') | join(' ') }}; do \
        if pixi run --as-is -e "$env" python -c "import importlib.util, sys; sys.exit(0 if importlib.util.find_spec('imageio_ffmpeg') else 1)"; then \
            echo "[imageio-ffmpeg] present in env '$env'; removing (unused -- we encode via PyAV -- and its bundled ffmpeg binary must not ship)" && \
            pixi run --as-is -e "$env" pip uninstall -y imageio-ffmpeg && \
            if pixi run --as-is -e "$env" python -c "import importlib.util, sys; sys.exit(1 if importlib.util.find_spec('imageio_ffmpeg') else 0)"; then \
                echo "[imageio-ffmpeg] confirmed removed from env '$env'"; \
            else \
                echo "ERROR: imageio-ffmpeg still present in env '$env' after uninstall; aborting build (this package must not remain in the image)" >&2; \
                exit 1; \
            fi; \
        fi; \
{% if redistributable %}        if pixi run --as-is -e "$env" python -c "import importlib.util, sys; sys.exit(0 if importlib.util.find_spec('av') else 1)"; then \
            pixi run --as-is -e "$env" pip uninstall -y av && \
            pixi run --as-is -e "$env" pip install --no-cache-dir /opt/cosmos-curator-wheelhouse/av-17.0.0-*.whl && \
            pixi run --as-is -e "$env" python -c "import av; print(av.__version__, av.library_versions)"; \
        fi; \
        if pixi run --as-is -e "$env" python -c "import importlib.util, sys; sys.exit(0 if importlib.util.find_spec('cv2') else 1)"; then \
            pixi run --as-is -e "$env" pip uninstall -y opencv-python-headless opencv-python opencv-contrib-python || true; \
            if [ "$env" = "paddle-ocr" ] || [ "$env" = "default" ]; then \
                pixi run --as-is -e "$env" pip install --no-cache-dir --no-deps /opt/cosmos-curator-wheelhouse/opencv_python-*.whl; \
            else \
                pixi run --as-is -e "$env" pip install --no-cache-dir --no-deps /opt/cosmos-curator-wheelhouse/opencv_python_headless-*.whl; \
            fi; \
            pixi run --as-is -e "$env" python -c 'import cv2; info = cv2.getBuildInformation(); print(cv2.__version__); print(next((line for line in info.splitlines() if "FFMPEG:" in line), "FFMPEG: <missing>")); raise SystemExit(0 if "FFMPEG:                      YES" in info else 1)'; \
        fi; \
{% else %}        pixi run --as-is -e "$env" python -c "print('pixi as-is smoke ok')"; \
        if pixi run --as-is -e "$env" python -c "import importlib.util, sys; sys.exit(0 if importlib.util.find_spec('av') else 1)"; then \
            pixi run --as-is -e "$env" python -c "import av; print(av.__version__, av.library_versions)"; \
        fi; \
        if pixi run --as-is -e "$env" python -c "import importlib.util, sys; sys.exit(0 if importlib.util.find_spec('cv2') else 1)"; then \
            pixi run --as-is -e "$env" python -c 'import cv2; info = cv2.getBuildInformation(); print(cv2.__version__); print(next((line for line in info.splitlines() if "FFMPEG:" in line), "FFMPEG: <missing>")); raise SystemExit(0 if "FFMPEG:                      YES" in info else 1)'; \
        fi; \
{% endif %}    done && \
{% if redistributable %}    found=$(find /opt/ffmpeg /usr/lib /usr/local/lib {{code_dir_str}}/.pixi -name 'libopenh264*' 2>/dev/null) && \
    if [ -n "$found" ]; then \
        echo "ERROR: redistributable PyAV/OpenCV rebuild produced or retained libopenh264:"; \
        echo "$found"; \
        exit 1; \
    fi && \
    if grep -q 'files.pythonhosted.org/.*/av-17.0.0' pixi.lock || \
       grep -q 'files.pythonhosted.org/.*/opencv_python_headless-' pixi.lock{% if 'paddle-ocr' in envs or 'default' in envs %} || \
       grep -q 'files.pythonhosted.org/.*/opencv_python-' pixi.lock || \
       grep -q 'files.pythonhosted.org/.*/opencv_contrib_python-' pixi.lock{% endif %}; then \
        echo "ERROR: full image runtime pixi.lock still references bundled PyPI wheels (av/opencv)"; \
        exit 1; \
    fi && \
    for env in {{ envs | reject('equalto', 'cuml') | join(' ') }}; do \
        pixi run --as-is -e "$env" python -c "print('pixi as-is smoke ok')"; \
    done && \
{% endif %}    pixi clean cache -y

{% if 'cuml' in envs %}
RUN cd {{code_dir_str}} && \
    export CONDA_OVERRIDE_CUDA=13.0.3 && \
{%- if verbose %}
    export RUST_LOG=uv=debug && \
    export UV_NO_PROGRESS=1 && \
    export NO_COLOR=1 && \
{%- endif %}
    success=false && \
    for attempt in {1..10}; do \
        echo "=== pixi install cuml attempt $attempt/10 ===" && \
        if pixi install {{ '-v' if verbose else '' }} -e cuml --frozen 2>&1; then \
            success=true && break; \
        fi; \
        echo "pixi install attempt $attempt/10 failed, retrying in 3s..." && sleep 3; \
    done && \
    $success && \
    pixi run --as-is -e cuml python -c "print('pixi as-is smoke ok')" && \
    pixi clean cache -y
{% endif %}{# cuml #}

COPY package/cosmos_curator/envs/ /tmp/cosmos_curator_build_envs
{% for env in post_install_envs %}
RUN cd {{code_dir_str}} && \
    pixi run --as-is -e {{ env }} bash /tmp/cosmos_curator_build_envs/{{ env }}/post_install.sh
{% endfor %}

{% if 'seedvr' in envs %}
COPY --chown=1000:1000 --from=wheels-builder /opt/seedvr-artifacts/SeedVR {{code_dir_str}}/SeedVR
COPY cosmos_curator/pipelines/video/super_resolution/color_fix.py \
     {{code_dir_str}}/SeedVR/projects/video_diffusion_sr/color_fix.py
# SeedVR2 setup() symlinks $SEEDVR_ROOT/ckpts -> the mounted weights at runtime.
# `local launch` runs as the host uid (not the image's 1000), so make just the
# SeedVR dir writable to allow creating that symlink entry. Use the sticky bit
# (1777, like /tmp) so any uid can create entries but only the owner can delete/
# rename them -- the 1000-owned source files stay tamper-proof (they are read-only).
RUN chmod 1777 {{code_dir_str}}/SeedVR
ENV SEEDVR_ROOT={{code_dir_str}}/SeedVR
{% endif %}

# For cosmos-xenna development.
# Requires a pre-built manylinux wheel matching THIS image's architecture
# (x86_64 or aarch64), placed at one of:
#   <repo-root>/target/wheels/cosmos_xenna-*manylinux*_<arch>.whl
#       (canonical / CI)
#   <repo-root>/cosmos-xenna/target/wheels/cosmos_xenna-*manylinux*_<arch>.whl
#       (maturin default when building inside the cosmos-xenna submodule)
{% if use_local_xenna_build %}
COPY ["targe[t]/whee[l]s/", "cosmos-xenn[a]/targe[t]/whee[l]s/", "/tmp/cosmos-xenna-wheels/"]
RUN ARCH="$(uname -m)" && \
    ls /tmp/cosmos-xenna-wheels/cosmos_xenna-*manylinux*_${ARCH}.whl >/dev/null 2>&1 \
    || { echo "ERROR: no cosmos-xenna manylinux ${ARCH} wheel found in target/wheels/ or cosmos-xenna/target/wheels/."; \
         echo "Found these wheels (none usable for this image, arch=${ARCH}):"; \
         ls /tmp/cosmos-xenna-wheels/ 2>/dev/null || echo "  (no wheels directory at all)"; \
         echo "Build a manylinux ${ARCH} wheel on the host first."; \
         exit 1; }
{% for env in envs %}
RUN ARCH="$(uname -m)" && \
    cd {{code_dir_str}} && \
    pixi run --as-is -e {{ env }} pip uninstall -y cosmos-xenna && \
    pixi run --as-is -e {{ env }} pip install /tmp/cosmos-xenna-wheels/cosmos_xenna-*manylinux*_${ARCH}.whl
{% endfor %}
{% endif %}

{% endif %}{# not slim #}

{% if slim %}
# Slim image: store the environments for runtime installation.
# The launch flow reads this variable and runs pixi install --frozen before the user command.
ENV COSMOS_CURATOR_SLIM_ENVS="{{ envs | join(',') }}"
LABEL cosmos-curator.slim="true"
{% endif %}

COPY --chown=1000:1000 cosmos_curator {{code_dir_str}}/cosmos_curator
COPY --chown=1000:1000 tests {{code_dir_str}}/tests
COPY --chown=1000:1000 pytest.ini .coveragerc {{code_dir_str}}/
COPY --chown=1000:1000 README.md ATTRIBUTIONS.md {{code_dir_str}}/
COPY --chown=1000:1000 --chmod=755 package/cosmos_curator/entrypoint.sh /usr/local/bin/cosmos-curator-entrypoint

{% for code_path in code_paths %}
COPY --chown=1000:1000 {{code_path}} {{code_dir_str}}/{{code_path}}
{% endfor %}

EXPOSE 8000 6379

WORKDIR {{code_dir_str}}
ENV PYTHONPATH={{code_dir_str}}

ENTRYPOINT ["/usr/local/bin/cosmos-curator-entrypoint"]
CMD ["pixi", "run", "--as-is", "python", "cosmos_curator/scripts/onto_nvcf.py", "--helm", "True"]
